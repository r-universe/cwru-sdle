[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "FAIRmaterials"]
	path = FAIRmaterials
	url = https://github.com/cran/FAIRmaterials
[submodule "geospatialsuite"]
	path = geospatialsuite
	url = https://github.com/cwru-sdle/geospatialsuite
[submodule "manureshed"]
	path = manureshed
	url = https://github.com/cwru-sdle/manureshed
